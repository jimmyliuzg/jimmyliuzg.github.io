---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio & Resume" } = Astro.props;
---
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script is:inline>
    // Light mode default — only opt into dark when explicitly saved.
    try {
      if (localStorage.getItem("theme") === "dark") document.documentElement.classList.add("dark");
    } catch (e) {}
  </script>
</head>
<body class="bg-light-bg dark:bg-dark-bg text-light-text dark:text-dark-text font-sans leading-relaxed">
  <!-- Top Navigation — Utrecht: wordmark left, links right, red hairline -->
  <Nav variant="multi" />

  <!-- Main Content with Utrecht side rail -->
  <div class="max-w-6xl mx-auto px-5 md:px-10 flex gap-10 pt-28 md:pt-32 pb-4">
    <aside class="hidden lg:flex justify-center shrink-0" aria-hidden="true">
      <p class="utrecht-vertical">
        Jimmy Liu / Technical Program Manager — NVIDIA / Bay Area, CA
      </p>
    </aside>
    <main class="flex-1 min-w-0">
      <slot />
    </main>
  </div>

  <Footer />

</body>
</html>
